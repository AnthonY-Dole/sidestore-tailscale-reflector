#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

RUNNER=/usr/lib/sidestore-reflector/run.sh

start_service() {
	config_load sidestore-reflector
	config_get_bool enabled main enabled 0

	[ "$enabled" = "1" ] || {
		logger -t sidestore-reflector -- "disabled in /etc/config/sidestore-reflector"
		return 0
	}

	procd_open_instance 'reflector'
	procd_set_param command /bin/sh "$RUNNER"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "sidestore-reflector"
}
